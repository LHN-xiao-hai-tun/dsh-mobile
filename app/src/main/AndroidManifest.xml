<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- v1.2.7：mDNS/NSD 组播发现需要 MulticastLock（部分机型不收组播）—— 仅局域网内监听，
         不申请定位/近场权限（那类权限用于 SSID 读取，本 App 不需要）。 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
        android:supportsRtl="true"
        android:theme="@style/Theme.DSH"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false">

        <!-- v1.3.0 说明（两条都是有意为之，不是漏配）：
             ① 去掉 android:usesCleartextTraffic —— 有了 networkSecurityConfig 后它会被忽略
                （minSdk 26 ⇒ 必走 API 24+ 的 XML 口径）。明文策略现在**只有一处**真源：
                res/xml/network_security_config.xml（全局放行明文 + 只信系统 CA）。
                按地址的放行判断在代码层 NetPolicy。
             ② allowBackup=false —— 偏好项里有加密值，而解密密钥在设备 Keystore 里、**不跟着云备份走**；
                若允许备份还原到新机，就会出现"备份回来了但解不开"。同时这也更符合本 App 的隐私口径。 -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.DSH.Splash"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/about_title" />

        <!-- v1.3.9 · B1 连接诊断页：只读探针（网络/端口/证书/响应），不申请任何新权限 -->
        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:label="@string/diag_title"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />

        <!-- 导出诊断日志（批 3-5）：只读暴露 cacheDir/exports/，供系统分享面板读取。
             ⚠️ exported=false + grantUriPermissions：只有用户当次选中的 App 能拿到那一份文件；
             不需要任何存储权限（本 App 至今零运行时权限）。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="app.dshmobile.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
