<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider 路径：只暴露 cacheDir/exports/（即 LogExporter 写日志的目录）。
  ⚠️ 路径名要与 LogExporter.PROVIDER_PATH 一致；不要开 <root-path> / <external-path>。
  这样即使 FileProvider 被误用，也只能拿到我们主动生成的那一个 txt，拿不到应用其它数据。
-->
<paths>
    <cache-path name="exports" path="exports/" />
</paths>